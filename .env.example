# Copy to .env.local (or pass as container environment). Every setting is optional.

# GitLab personal access token. If set, the token screen is skipped and the
# snapshot is loaded at startup, so the first page open is instant.
# Scope: `api` for read/write, `read_api` for read-only.
# Anyone who can reach the varatlas server acts with this token, so keep it on localhost.
GITLAB_TOKEN=

# GitLab instance. Defaults to https://gitlab.com
GITLAB_BASE_URL=https://gitlab.com

# Comma-separated path segments to skip during discovery. A group or project is
# skipped if any segment of its full path matches (case-insensitive).
# Example: sandbox,archive
VARATLAS_EXCLUDE_PATHS=

# Comma-separated hostnames the server answers API requests for (DNS-rebinding guard).
# Defaults to localhost,127.0.0.1,::1. Only extend this if you put varatlas behind
# your own authenticating reverse proxy.
VARATLAS_ALLOWED_HOSTS=

# Listen address and port. Defaults: 127.0.0.1 and 3131 (the container image uses 0.0.0.0).
HOST=
PORT=
